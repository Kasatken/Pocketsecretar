[Unit]
Description=PocketSecret Go API
After=network-online.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/pocketsecret
ExecStart=/opt/pocketsecret/server
Restart=always
RestartSec=5
EnvironmentFile=/etc/pocketsecret/pocketsecret.env

[Install]
WantedBy=multi-user.target
