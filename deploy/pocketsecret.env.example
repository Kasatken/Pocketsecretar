PORT=8080
DATABASE_URL=<заполните>
CORS_ALLOWED_ORIGIN=https://pocketsecretary.ru
JWT_ACCESS_SECRET=<заполните>
JWT_REFRESH_SECRET=<заполните>
ACCESS_TTL_MIN=15
OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_MODEL_ADVICE=deepseek/deepseek-v4-flash
REFRESH_TTL_DAYS=14
OPENROUTER_API_KEY=<заполните>
OPENROUTER_PROXY=<заполните>
TOKEN_ENCRYPTION_KEY=<заполните>
COOKIE_SECURE=true
GOOGLE_CLIENT_ID=<заполните>
GOOGLE_CLIENT_SECRET=<заполните>
# URL, на который Google вернёт пользователя после входа (должен совпадать с "Authorized redirect URIs" в Google Cloud Console).
# Локальная разработка:
GOOGLE_REDIRECT_URI=https://pocketsecretary.ru/api/auth/google/callback
# Продакшен (HTTPS): раскомментируйте и добавьте этот URI в Google Cloud Console → Authorized redirect URIs:
# GOOGLE_REDIRECT_URI=https://pocketsecretary.ru/api/auth/google/callback
PRO_PROMO_CODE=<заполните>
FREE_SMART_TASK_LIMIT=3
PRO_SMART_TASK_LIMIT=30
FREE_ADVICE_REFRESH_PER_HOUR=5
PRO_ADVICE_REFRESH_PER_HOUR=30
# Telegram-бот. Реальные значения задаются только на сервере в /etc/pocketsecret/pocketsecret.env —
# в репозиторий токен не коммитим. Пока переменные пустые, бот выключен и вебхук не поднимается.
# TELEGRAM_WEBHOOK_SECRET — произвольная строка (openssl rand -hex 32), её же передаём в setWebhook.
TELEGRAM_BOT_TOKEN=<заполните>
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=<заполните>
